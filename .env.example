# Copy this file to .env (gitignored) and fill in your local values.
# Never commit .env. Never put ADB pairing codes here: pair once interactively, then
# only the connect address below is needed.

# Frigate server (the app's default "Home" profile is built from these)
FRIGATE_HOST=192.168.x.x
FRIGATE_PORT=9150
FRIGATE_RTSP_PORT=8554

# Google TV Streamer over wireless ADB. The connect port changes whenever Wireless
# debugging restarts; check the device's Wireless debugging screen (or `adb mdns services`).
TV_ADB_SERIAL=192.168.x.x:xxxxx

# Phone (optional). Leave empty if not connected.
PHONE_ADB_SERIAL=
