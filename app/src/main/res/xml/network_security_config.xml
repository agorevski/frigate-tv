<?xml version="1.0" encoding="utf-8"?>
<!--
  Android cannot scope cleartext traffic by IP range, and profiles hold user-entered LAN
  addresses (the default profile is plain HTTP), so cleartext is permitted at base level.
  HTTPS trust is not weakened: only the system trust anchors are accepted, with no user-installed
  CAs and no global TLS overrides.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
